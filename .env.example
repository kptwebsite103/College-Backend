# Copy this file to .env and fill real secrets — NEVER commit your .env file

# App
PORT=3000
NODE_ENV=development

# Database (MySQL)
MYSQL_HOST=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
MYSQL_PORT=3306
MYSQL_CONNECT_TIMEOUT_MS=10000
# Set to false to allow server startup even when DB is unreachable (dev only)
DB_REQUIRED=true

# Auth / Secrets
JWT_SECRET=
JWT_REFRESH_SECRET=
CLERK_API_KEY=

# CORS
CORS_ORIGIN=https://kpt-mangalore-autonomous.vercel.app,http://localhost:5173,http://localhost:3000,http://localhost:5174

# Cloud providers (disabled by default - project uses local filesystem uploads)
# CLOUDINARY_URL=
# IMAGEKIT_URL_ENDPOINT=
# IMAGEKIT_PUBLIC_KEY=
# IMAGEKIT_PRIVATE_KEY=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=
# AWS_REGION=
# Optional: absolute path for upload storage.
# For Render with persistent disk, set this to /var/data/uploads
# UPLOADS_DIR=/var/data/uploads

# Caching / Queues
REDIS_URL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Redis connection retry settings
REDIS_CONN_RETRY_ATTEMPTS=5
REDIS_CONN_RETRY_DELAY_MS=2000
REDIS_CONNECT_TIMEOUT_MS=10000

# Bull (job queue) defaults
BULL_DEFAULT_RETRIES=3
BULL_DEFAULT_BACKOFF_MS=5000
BULL_DEFAULT_CONCURRENCY=5
BULL_CLOSE_TIMEOUT_MS=5000

# Search
ELASTICSEARCH_URL=
ELASTICSEARCH_INDEX_PREFIX=
ELASTICSEARCH_SHARDS=1
ELASTICSEARCH_REPLICAS=1

# Third-party services
SENTRY_DSN=
SENDGRID_API_KEY=
STRIPE_SECRET_KEY=
